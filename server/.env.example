# Copy to server/.env

# mock (default, offline) | openai (any OpenAI-compatible VLM endpoint)
VLM_MODE=mock

# --- only for VLM_MODE=openai ---
# vLLM / Ollama / OpenRouter / etc.
VLM_BASE_URL=https://openrouter.ai/api/v1
VLM_API_KEY=sk-...
VLM_MODEL=qwen/qwen-2.5-vl-7b-instruct
# offline example:
# VLM_BASE_URL=http://localhost:11434/v1
# VLM_MODEL=llama3.2-vision
