{
  "manifest_version": 3,
  "name": "Privacy Lens",
  "version": "1.0.0",
  "description": "Finds sensitive form fields on the current page without reading their values.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Scan page for sensitive fields",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
